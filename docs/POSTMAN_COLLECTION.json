{
  "info": {
    "name": "API REST - Transações",
    "description": "Coleção para testar CRUD de transações via Proxy Reverso (Nginx)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Transações",
      "item": [
        {
          "name": "Listar Todas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://192.168.1.10/transacoes",
              "protocol": "http",
              "host": ["192", "168", "1", "10"],
              "port": "80",
              "path": ["transacoes"]
            }
          },
          "response": []
        },
        {
          "name": "Criar Transação",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Professor Fulano\",\n  \"valor\": 100.00,\n  \"data\": \"2026-05-29\",\n  \"tipo\": \"RECEITA\"\n}"
            },
            "url": {
              "raw": "http://192.168.1.10/transacoes",
              "protocol": "http",
              "host": ["192", "168", "1", "10"],
              "port": "80",
              "path": ["transacoes"]
            }
          },
          "response": []
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://192.168.1.10/transacoes/1",
              "protocol": "http",
              "host": ["192", "168", "1", "10"],
              "port": "80",
              "path": ["transacoes", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Atualizar Transação",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Professor Fulano Atualizado\",\n  \"valor\": 200.00,\n  \"data\": \"2026-05-29\",\n  \"tipo\": \"DESPESA\"\n}"
            },
            "url": {
              "raw": "http://192.168.1.10/transacoes/1",
              "protocol": "http",
              "host": ["192", "168", "1", "10"],
              "port": "80",
              "path": ["transacoes", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Deletar Transação",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://192.168.1.10/transacoes/1",
              "protocol": "http",
              "host": ["192", "168", "1", "10"],
              "port": "80",
              "path": ["transacoes", "1"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
